+/* Rank in the top recorded bucket. Needs counts >= 0 summing to total_count; else the scan decides. */
+static bool tail_top_bucket(const struct hdr_histogram* h, int64_t target, int32_t* idx)
+{
+    const int64_t total = h->total_count;
+    if (h->normalizing_index_offset != 0 || h->max_value <= 0 || h->max_value > h->highest_trackable_value ||
+        total > (INT64_C(1) << 53))
+        return false;
+    const int32_t mi = counts_index_for(h, h->max_value);
+    if ((uint32_t)mi >= (uint32_t)h->counts_len)
+        return false;
+    const int64_t cm = h->counts[mi];
+    if (cm <= 0 || cm > total || target <= total - cm)
+        return false;
+    *idx = mi;
+    return true;
+}
